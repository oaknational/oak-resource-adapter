{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@oaknational/resource-adapter-db#build": {
      "env": ["DATABASE_URL"],
      "outputs": ["generated/**"]
    },
    "@oaknational/resource-adapter-db#type-check": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "env": ["DATABASE_URL"],
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "RUN_DATABASE_INTEGRATION_TESTS"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "RUN_DATABASE_INTEGRATION_TESTS"],
      "outputs": []
    }
  }
}
