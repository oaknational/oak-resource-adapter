{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DEBUG",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "ENABLE_DEV_ROUTES",
        "OPENAI_API_KEY",
        "POSTHOG_API_KEY",
        "POSTHOG_HOST",
        "RESOURCE_ADAPTER_ALLOWED_ORIGINS",
        "RESOURCE_ADAPTER_ALLOWED_ORIGIN_PATTERNS",
        "RESOURCE_ADAPTER_API_BYPASS_SECRET",
        "RESOURCE_ADAPTER_API_ORIGIN",
        "SENTRY_ENVIRONMENT",
        "USE_POSTHOG",
        "VERCEL_ENV"
      ],
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "RUN_DATABASE_INTEGRATION_TESTS"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^build"],
      "env": [
        "CURRICULUM_API_URL",
        "CURRICULUM_DB_HASURA_AUTH_RESOURCE_ADAPTER_API_KEY",
        "CURRICULUM_DOWNLOADS_API_URL",
        "DATABASE_URL",
        "RUN_DATABASE_INTEGRATION_TESTS"
      ],
      "outputs": []
    }
  }
}
