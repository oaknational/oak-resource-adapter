{
  "name": "@oaknational/resource-adapter-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Local OWA-like host for Resource Adapter",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "lint": "eslint . --max-warnings=0",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "test": "vitest run",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.0",
    "@oaknational/oak-components": "^3.30.2",
    "@oaknational/resource-adapter": "workspace:*",
    "@oaknational/resource-adapter-dev-api-contracts": "workspace:*",
    "@oaknational/resource-adapter-logger": "workspace:*",
    "@oaknational/resource-adapter-original-resource-documents": "workspace:*",
    "@oaknational/resource-document": "workspace:*",
    "@portabletext/react": "^4.0.3",
    "next": "^16.4.6",
    "next-cloudinary": "^7.1.0",
    "posthog-js": "^1.450.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
