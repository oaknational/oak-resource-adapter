{
  "name": "@oaknational/resource-adapter-harness",
  "version": "0.0.0",
  "private": true,
  "description": "Local OWA-like host for Resource Adapter",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "lint": "eslint . --max-warnings=0",
    "start": "dotenv -e ../../.env -- next start --port 3000",
    "test": "vitest run",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.3",
    "@oaknational/oak-components": "^3.14.4",
    "@oaknational/resource-adapter": "workspace:*",
    "@oaknational/resource-adapter-logger": "workspace:*",
    "@oaknational/resource-adapter-original-resource-documents": "workspace:*",
    "@oaknational/resource-document": "workspace:*",
    "next": "^16.3.4",
    "next-cloudinary": "^6.18.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.5.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "dotenv-cli": "^11.0.0",
    "vitest": "^4.1.11"
  }
}
