{
  "name": "@oaknational/resource-adapter-api",
  "version": "0.0.0",
  "private": true,
  "description": "Resource Adapter API and background worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "dotenv -e ../../.env -- next dev --port 3001",
    "lint": "eslint . --max-warnings=0",
    "start": "dotenv -e ../../.env -- next start --port 3001",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:integration": "RUN_DATABASE_INTEGRATION_TESTS=1 vitest run integration.test",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.2",
    "@oaknational/resource-adapter-ai": "workspace:*",
    "@oaknational/resource-adapter-contracts": "workspace:*",
    "@oaknational/resource-adapter-curriculum": "workspace:*",
    "@oaknational/resource-adapter-db": "workspace:*",
    "@oaknational/resource-adapter-logger": "workspace:*",
    "@oaknational/resource-adapter-original-resource-documents": "workspace:*",
    "@oaknational/resource-adapter-storage": "workspace:*",
    "@oaknational/resource-document": "workspace:*",
    "@sentry/nextjs": "^10.74.0",
    "@trpc/server": "11.18.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "image-size": "^2.0.2",
    "next": "^16.3.5",
    "openai": "7.15.0",
    "posthog-node": "^5.52.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workflow": "4.8.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv-cli": "^11.0.0",
    "fast-xml-parser": "^5.11.1",
    "fast-xml-validator": "^1.4.2",
    "fflate": "^0.8.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
