{
  "name": "@oaknational/resource-adapter-api",
  "version": "0.0.0",
  "private": true,
  "description": "Resource Adapter capabilities API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3001",
    "lint": "eslint . --max-warnings=0",
    "start": "next start --port 3001",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "type-check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "@oaknational/resource-adapter-contracts": "workspace:*",
    "next": "^16.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
