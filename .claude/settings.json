{
  "enabledMcpjsonServers": ["linear", "playwright"],
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm type-check)",
      "Bash(pnpm type-check *)",
      "Bash(pnpm format)",
      "Bash(pnpm format *)",
      "Bash(pnpm format:fix)",
      "Bash(pnpm format:fix *)",
      "Bash(pnpm exec prettier --write *)",
      "Bash(pnpm exec drizzle-kit check *)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * lint *)",
      "Bash(pnpm --filter * type-check *)",
      "Bash(pnpm --filter * exec tsc *)",
      "Bash(pnpm db:check)",
      "Bash(pnpm db:check *)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm test:coverage *)",
      "Bash(git fetch *)",
      "Bash(npm show *)",
      "Bash(npm view *)",
      "Bash(pg_isready)",
      "Bash(pg_isready *)",
      "Bash(terraform fmt -check *)",
      "Bash(terraform validate *)"
    ]
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-edited-file.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-changed-packages.sh\"",
            "timeout": 600,
            "statusMessage": "Type-checking and linting changed packages"
          }
        ]
      }
    ]
  }
}
