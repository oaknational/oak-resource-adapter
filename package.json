{
  "name": "resource-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Oak National Academy Resource Adapter",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --parallel",
    "db:generate": "pnpm --filter @oaknational/resource-adapter-db db:generate",
    "db:migrate:dev": "pnpm --filter @oaknational/resource-adapter-db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @oaknational/resource-adapter-db db:migrate:deploy",
    "db:validate": "pnpm --filter @oaknational/resource-adapter-db db:validate",
    "doppler:pull:dev": "doppler secrets download --project oak-resource-adapter --config dev --no-file --format env > .env",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky",
    "secrets:scan": "gitleaks detect --redact=100 --source . --log-opts=\"--branches --tags\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run test:integration",
    "test:artifact": "node scripts/check-package-artifact.mjs",
    "test:e2e": "pnpm build && node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@clerk/testing": "^2.2.14",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.5.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  }
}
