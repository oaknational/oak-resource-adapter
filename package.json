{
  "name": "resource-adapter",
  "version": "0.0.0",
  "private": true,
  "description": "Oak National Academy Resource Adapter",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "ci:publish": "turbo run build --filter=@oaknational/resource-adapter... && changeset publish",
    "ci:version": "changeset version && pnpm install --lockfile-only",
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev --parallel",
    "docker:db:bootstrap": "pnpm run docker:db:clear && pnpm run docker:db:run",
    "docker:db:clear": "docker ps -a --format '{{.Names}}' | grep -qx resource-adapter-postgres && docker stop resource-adapter-postgres && docker rm resource-adapter-postgres || echo 'Container resource-adapter-postgres does not exist.'",
    "docker:db:psql": "docker exec -it resource-adapter-postgres psql -U oai -d oak_resource_adapter",
    "docker:db:reset": "pnpm run docker:db:clear && pnpm run docker:db:run",
    "docker:db:run": "docker run --name resource-adapter-postgres -e POSTGRES_USER=oai -e POSTGRES_PASSWORD=oai -e POSTGRES_DB=oak_resource_adapter -p 5432:5432 -d postgres:16",
    "db:check": "pnpm --filter @oaknational/resource-adapter-db db:check",
    "db:generate": "pnpm --filter @oaknational/resource-adapter-db db:generate",
    "db:migrate:dev": "pnpm --filter @oaknational/resource-adapter-db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @oaknational/resource-adapter-db db:migrate:deploy",
    "db:reset": "pnpm --filter @oaknational/resource-adapter-db db:reset",
    "db:studio": "pnpm --filter @oaknational/resource-adapter-db db:studio",
    "deps:check": "pnpm deps:check:manifests && depcruise apps packages/*/src packages/*/scripts packages/*/*.ts packages/*/*.mjs --config dependency-cruiser.config.mjs",
    "deps:check:manifests": "node scripts/check-workspace-dependencies.mjs",
    "env:pull:dev": "node scripts/pull-dev-env.mjs",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "husky",
    "secrets:scan": "gitleaks detect --redact=100 --source . --log-opts=\"--branches --tags\"",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run test:integration",
    "test:artifact": "node scripts/check-package-artifact.mjs",
    "test:e2e": "pnpm build && node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "test:e2e:deployment": "node --env-file-if-exists=.env scripts/run-deployment-tests.mjs",
    "type-check": "turbo run type-check && tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@clerk/testing": "^2.2.14",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dependency-cruiser": "18.1.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "husky": "9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.5.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vercel": "58.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
