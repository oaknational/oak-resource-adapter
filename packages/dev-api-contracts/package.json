{
  "name": "@oaknational/resource-adapter-dev-api-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Wire schemas for the Resource Adapter dev API, shared by the API and harness",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@oaknational/resource-adapter-contracts": "workspace:*",
    "@oaknational/resource-document": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
