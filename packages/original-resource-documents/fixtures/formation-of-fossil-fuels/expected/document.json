              "text": "Task A: Coal"
            }
          ]
        },
        {
          "id": "question-1",
          "type": "question",
          "children": [
            {
              "id": "unstable:paragraph-arrange-the-following-statements-into-the-correct-orde",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Arrange the following statements into the correct order to describe how coal is formed:"
                }
              ]
            },
            {
              "id": "coal-formation-order",
              "type": "table",
              "role": "table",
              "header": [
                {
                  "kind": "content",
                  "content": [
                    {
                      "type": "text",
                      "text": "Statement"
                    }
                  ]
                },
                {
                  "kind": "content",
                  "content": [
                    {
                      "type": "text",
                      "text": "Order"
                    }
                  ]
                }
              ],
              "rows": [
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "Further high temperatures and pressure turn the peat into carbon-rich coal."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "The plants are covered in layers of mud and additional dead plants."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "Plants living in swampy forests die."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "Anaerobic conditions along with high temperatures and pressure turn the dead plants into peat."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  }
                ]
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "task-b",
      "type": "task",
      "children": [
        {
          "id": "task-b-heading",
          "type": "heading",
          "level": 2,
          "content": [
            {
              "type": "text",
              "text": "Task B: Crude oil and natural gas"
            }
          ]
        },
        {
          "id": "task-b-instruction",
          "layout": {
            "keepWithNext": true
          },
          "type": "callout",
          "role": "instruction",
          "content": [
            {
              "type": "text",
              "text": "Decide if the following statements are true or false. Make changes to improve any incorrect statements."
            }
          ]
        },
        {
          "id": "question-2",
          "type": "question",
          "children": [
            {
              "id": "fossil-fuel-statements",
              "type": "table",
              "role": "table",
              "header": [
                {
                  "kind": "content",
                  "content": [
                    {
                      "type": "text",
                      "text": "Statement"
                    }
                  ]
                },
                {
                  "kind": "content",
                  "content": [
                    {
                      "type": "text",
                      "text": "True or false"
                    }
                  ]
                },
                {
                  "kind": "content",
                  "content": [
                    {
                      "type": "text",
                      "text": "Improved statement"
                    }
                  ]
                }
              ],
              "rows": [
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "a) Coal is made from plankton and mainly contains carbon."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "b) Coal is a combustible, sedimentary rock."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "c) Coal may contain impurities such as sulfur."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "d) Natural gas and crude oil are made from plankton."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "e) Natural gas and crude oil do not contain hydrocarbons."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "f) Natural gas is formed from phytoplankton and crude oil is formed from zooplankton."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ],
                [
                  {
                    "kind": "content",
                    "content": [
                      {
                        "type": "text",
                        "text": "g) Coal, crude oil and natural gas are renewable resources."
                      }
                    ]
                  },
                  {
                    "kind": "answer"
                  },
                  {
                    "kind": "answer"
                  }
                ]
              ]
            }
          ]
        }
      ]
