      "type": "task",
      "children": [
        {
          "id": "task-a-heading",
          "type": "heading",
          "level": 2,
          "content": [
            {
              "type": "text",
              "text": "Task A: Understanding dependency"
            }
          ]
        },
        {
          "id": "task-a-instruction",
          "layout": {
            "keepWithNext": true
          },
          "type": "callout",
          "role": "instruction",
          "content": [
            {
              "type": "text",
              "text": "Circle the stretched second idea that is dependent on the first idea in each sentence. Remember that it will begin with ‘because’."
            }
          ]
        },
        {
          "id": "question-1",
          "type": "question",
          "children": [
            {
              "id": "sentence-1",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "The gong on the clock sounded because it was midnight."
                }
              ]
            },
            {
              "id": "sentence-2",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "We can’t go outside because you haven’t got your shoes on."
                }
              ]
            },
            {
              "id": "sentence-3",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "I enjoy going to school because we learn interesting things."
                }
              ]
            },
            {
              "id": "sentence-4",
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Aisha put her hand up because she knew the answer."
                }
              ]
            }
          ]
        }
      ]
    },
