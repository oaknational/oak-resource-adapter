{
  "name": "@oaknational/resource-document",
  "version": "0.1.0",
  "description": "Application-agnostic resource document schemas and parsing",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-resource-adapter.git",
    "directory": "packages/resource-document"
  },
  "homepage": "https://github.com/oaknational/oak-resource-adapter/tree/main/packages/resource-document#readme",
  "bugs": {
    "url": "https://github.com/oaknational/oak-resource-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "import": "./dist/parse.js",
      "default": "./dist/parse.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./markup": {
      "types": "./dist/markup/index.d.ts",
      "import": "./dist/markup/index.js",
      "default": "./dist/markup/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "EXTRACTION_HANDOFF.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "pnpm build",
    "publish:local": "pnpm build && yalc publish --no-scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
