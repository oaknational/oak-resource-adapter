{
  "name": "@oaknational/resource-adapter",
  "version": "0.1.0",
  "description": "React UI for Oak National Academy Resource Adapter",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-resource-adapter.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/oaknational/oak-resource-adapter/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/oaknational/oak-resource-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json",
    "dev": "tsup --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "pnpm build",
    "publish:local": "pnpm build && yalc publish --no-scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@oaknational/oak-components": "^3.0.0",
    "next": ">=16.0.0",
    "next-cloudinary": ">=6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": ">=5.3.11"
  },
  "devDependencies": {
    "@oaknational/oak-components": "^3.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "next": "^16.1.0",
    "next-cloudinary": "^6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@oaknational/resource-adapter-contracts": "workspace:*",
    "@trpc/client": "11.18.0"
  }
}
