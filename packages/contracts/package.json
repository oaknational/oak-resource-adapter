{
  "name": "@oaknational/resource-adapter-contracts",
  "version": "0.1.0",
  "description": "Shared tRPC contracts for Resource Adapter services and UI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-resource-adapter.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/oaknational/oak-resource-adapter/tree/main/packages/contracts#readme",
  "bugs": {
    "url": "https://github.com/oaknational/oak-resource-adapter/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "default": "./dist/internal.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "prepublishOnly": "pnpm build",
    "publish:local": "pnpm build && yalc publish --no-scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
