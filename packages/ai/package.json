{
  "name": "@oaknational/resource-adapter-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Model invocation infrastructure for Resource Adapter",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:integration": "RUN_DATABASE_INTEGRATION_TESTS=1 vitest run src/persistence/model-invocation.integration.test.ts",
    "test:integration:openai": "RUN_OPENAI_INTEGRATION_TESTS=1 vitest run src/openai-responses-transport.integration.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@oaknational/resource-adapter-db": "workspace:*",
    "@oaknational/resource-adapter-logger": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "openai": "6.49.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  }
}
