{
  "name": "@oaknational/resource-adapter-db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL and Drizzle setup for Resource Adapter",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate:deploy": "node scripts/migrate.mjs",
    "db:migrate:dev": "drizzle-kit migrate",
    "db:reset": "node scripts/reset.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint scripts src --max-warnings=0",
    "lint:fix": "eslint scripts src --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "test:integration": "RUN_DATABASE_INTEGRATION_TESTS=1 vitest run src/schema.integration.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10"
  }
}
