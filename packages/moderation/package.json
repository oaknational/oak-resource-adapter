{
  "name": "@oaknational/resource-adapter-moderation",
  "version": "0.0.0",
  "private": true,
  "description": "Oak AI Moderation Service client for Resource Adapter",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "smoke:moderation": "RUN_MODERATION_INTEGRATION_TESTS=1 vitest run src/oak-moderation.integration.test.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@oaknational/resource-adapter-logger": "workspace:*",
    "@vercel/oidc": "^4.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  }
}
