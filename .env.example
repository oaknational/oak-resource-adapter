# Doppler is the source of truth for secrets. Normally you don't edit .env by
# hand — run `pnpm doppler:pull:dev` to generate it from Doppler's dev config.
#
# This file is a fallback for contributors without Doppler access: copy it to
# .env and set the values manually. Drizzle and the Next.js dev server read .env
# directly, so local development works without the Doppler CLI.

# Use any local PostgreSQL instance you control.
DATABASE_URL="postgresql://oai:oai@localhost:5432/oak_resource_adapter"

# Logger namespaces (comma-separated; e.g. "ra:*" for everything, "ra:*,-ra:db"
DEBUG=

# --- API and harness wiring ---
# Where the harness proxy forwards its API calls. Server-side and read at run
# time, so one harness build can be paired with any API deployment.
RESOURCE_ADAPTER_API_ORIGIN="http://localhost:3001"

# Comma-separated origins the API accepts cross-origin requests from. Defaults to
# http://localhost:3000 when unset.
RESOURCE_ADAPTER_ALLOWED_ORIGINS=

# Comma-separated origin patterns, each taking a single `*` for one hostname
# label, e.g. https://oak-resource-adapter-harness-*.vercel.thenational.academy.
# Lets Previews be accepted without listing them. Patterns outside
# thenational.academy are ignored, and all patterns are ignored in production.
RESOURCE_ADAPTER_ALLOWED_ORIGIN_PATTERNS=

# Lets the harness proxy reach a protected API Preview. Vercel provides it;
# unset locally.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Enables the /dev/* testing routes. Absent means they return 404.
ENABLE_DEV_ROUTES="1"

# --- Feature flags (apps/api) ---
# Selects the PostHog adapter over the in-memory one. Production always uses
# PostHog regardless of this value; unset means in-memory flags locally.
USE_POSTHOG=

# Required whenever the PostHog adapter is selected — startup throws without it.
POSTHOG_API_KEY=

# Defaults to the EU host (https://eu.i.posthog.com) when unset.
POSTHOG_HOST=

# --- OpenAI (packages/ai) ---
# Server-side only, required for the OpenAI transport.
OPENAI_API_KEY=

# --- Sentry (apps/api) ---
# Enables Sentry error reporting. If missing in production, API startup fails
# immediately. In non-production (dev/tests/CI), Sentry is skipped. Server-side
# only.
SENTRY_DSN=

# Org/project the build plugin uploads source maps to (read from the env by the
# Sentry plugin; not secret).
SENTRY_ORG="oak-national-academy"
SENTRY_PROJECT="oak-resource-adapter"


# Optional: tags events by deploy environment (e.g. production, staging).
SENTRY_ENVIRONMENT=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Existing Clerk user email used by Playwright to sign in via @clerk/testing.
E2E_CLERK_USER_EMAIL=
