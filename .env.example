# Use any local PostgreSQL instance you control.
DATABASE_URL="postgresql://postgres@localhost:5432/resource_adapter"

# Logger namespaces (comma-separated; e.g. "ra:*" for everything, "ra:*,-ra:db"
DEBUG=

# --- Sentry (apps/api) ---
# Enables Sentry error reporting. Absent -> Sentry never initialises, nothing is
# sent (keeps local dev, tests and the harness silent). Server-side only.
SENTRY_DSN=

# Org/project the build plugin uploads source maps to (read from the env by the
# Sentry plugin; not secret).
SENTRY_ORG="oak-national-academy"
SENTRY_PROJECT="oak-resource-adapter"


# Optional: tags events by deploy environment (e.g. production, staging).
SENTRY_ENVIRONMENT=
