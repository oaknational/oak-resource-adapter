# Doppler is the source of truth for secrets. Normally you don't edit .env by
# hand — run `pnpm doppler:pull:dev` to generate it from Doppler's dev config.
#
# This file is a fallback for contributors without Doppler access: copy it to
# .env and set the values manually. Drizzle and the Next.js dev server read .env
# directly, so local development works without the Doppler CLI.

# Use any local PostgreSQL instance you control.
DATABASE_URL="postgresql://postgres@localhost:5432/resource_adapter"

# Logger namespaces (comma-separated; e.g. "ra:*" for everything, "ra:*,-ra:db"
DEBUG=

# --- API and harness wiring ---
# Where the harness sends its API calls. Both are read at build time and baked
# into the client bundle, so a harness build belongs to one environment.
NEXT_PUBLIC_RESOURCE_ADAPTER_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_RESOURCE_ADAPTER_TRPC_ENDPOINT="http://localhost:3001/trpc/v1"

# Comma-separated origins the API accepts cross-origin requests from. Defaults to
# http://localhost:3000 when unset.
RESOURCE_ADAPTER_ALLOWED_ORIGINS=

# Enables the /dev/* testing routes. Absent means they return 404.
ENABLE_DEV_ROUTES="1"

# --- Sentry (apps/api) ---
# Enables Sentry error reporting. If missing in production, API startup fails
# immediately. In non-production (dev/tests/CI), Sentry is skipped. Server-side
# only.
SENTRY_DSN=

# Org/project the build plugin uploads source maps to (read from the env by the
# Sentry plugin; not secret).
SENTRY_ORG="oak-national-academy"
SENTRY_PROJECT="oak-resource-adapter"


# Optional: tags events by deploy environment (e.g. production, staging).
SENTRY_ENVIRONMENT=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Existing Clerk user email used by Playwright to sign in via @clerk/testing.
E2E_CLERK_USER_EMAIL=
